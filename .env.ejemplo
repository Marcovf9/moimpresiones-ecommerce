# Copiá este archivo como `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Copiá la línea "API environment variable" del panel de Cloudinary
# (Settings → API Keys). Viene con este formato:
#
#   cloudinary://<api_key>:<api_secret>@wadqifnu
#
CLOUDINARY_URL=

# Con esto el backend guarda las fotos en Cloudinary en lugar del disco.
# Dejalo en "local" mientras desarrollás sin conexión.
MEDIA_PROVIDER=cloudinary

# ── Producción ────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generá uno con: openssl rand -base64 48
JWT_SECRET=

# Usuario del panel de administración
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Aviso por mail de cotizaciones nuevas ─────────────────────────────────────
# Sin MAIL_HOST los avisos quedan apagados (el sitio funciona igual).
# Con Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, el usuario es la casilla
# y MAIL_PASSWORD una "contraseña de aplicación" (no la clave normal).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# A dónde llega el aviso y desde qué dirección sale.
NOTIFICACIONES_DESTINO=contacto@moimpresiones.com
NOTIFICACIONES_REMITENTE=
